# ==============================================================================
# SECURE CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local for local development.
# NEVER commit your actual .env or .env.local file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY SECRETS (Never exposed to the browser)
# In Next.js, variables WITHOUT the 'NEXT_PUBLIC_' prefix cannot be accessed by client code.
# ------------------------------------------------------------------------------

# Database Connection (e.g., PostgreSQL / Supabase / MongoDB)
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Email Delivery Provider (e.g., Resend, SendGrid, or Nodemailer)
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="notifications@ptmjaufarswadiq.com"
# SMTP_PASSWORD="super-secret-smtp-password"

# Authentication Secrets (NextAuth / JWT)
# AUTH_SECRET="generate-a-32-byte-secret-via-openssl-rand-hex-32"

# ------------------------------------------------------------------------------
# 2. PUBLIC CLIENT VARIABLES (Safely exposed to the frontend)
# Only variables prefixed with 'NEXT_PUBLIC_' are accessible in React components.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
